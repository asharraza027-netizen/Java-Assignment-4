import java.util.HashSet;
import java.util.Scanner;

class Attendance {
    private HashSet<String> presentStudents = new HashSet<>();

    public void markAttendance(String name) {
        // add() returns false if the item is already in the set
        if (presentStudents.add(name)) {
            System.out.println("Attendance marked for " + name);
        } else {
            System.out.println(name + " is already marked present");
        }
    }

    public void displayAttendance() {
        System.out.println("Present Students: " + presentStudents);
    }
}

public class Q2_AttendanceSystem {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Attendance attendance = new Attendance();

        System.out.print("Enter name to mark attendance: ");
        String name1 = scanner.nextLine();
        attendance.markAttendance(name1);

        System.out.print("Enter name to mark attendance: ");
        String name2 = scanner.nextLine();
        attendance.markAttendance(name2);

        attendance.displayAttendance();
        scanner.close();
    }
}
